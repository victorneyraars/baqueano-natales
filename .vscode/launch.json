{
  "version": "0.2.0",
  "configurations": [
    {
      "name": "Client Dev",
      "request": "launch",
      "type": "dart",
      "cwd": "${workspaceFolder}/flutter",
      "program": "lib/main_client.dart",
      "args": [
        "--flavor", "clientDev",
        "--dart-define-from-file=dart_defines/client_dev.json"
      ],
      "flutterMode": "debug"
    },
