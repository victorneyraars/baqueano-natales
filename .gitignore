# --- Excepciones: config pública de Firebase (SÍ al repo) ---
# El google-services.json NO es un secreto: contiene API keys públicas
# que van en el APK de todos modos. Sin él, no se puede compilar.
!flutter/android/app/google-services.json

# Certificados TLS (self-signed / Let's Encrypt)
deploy/nginx/certs/

# --- Backups de compose/nginx (temporales, no commitear) ---
*.backup-*
backend/secrets/
deploy/legal/

# APKs de desarrollo (se generan en CI y se sirven por Nginx)
deploy/apks/*.apk
deploy/apks/*.sha256
deploy/apks/*.apk.sha256

# Archivos generados por CI/CD en el servidor
deploy/apks/archive/
deploy/apks/version.json
