# =========================================================
# Baqueano Natales - Plantilla de variables de entorno
# =========================================================
# Copiar a .env y completar con valores reales:
#   cp .env.example .env
#   chmod 600 .env
# =========================================================

# --- Ambiente ---
ENVIRONMENT=production
DEBUG=false
LOG_LEVEL=INFO

# --- Postgres ---
POSTGRES_USER=baqueano_user
POSTGRES_PASSWORD=CAMBIAR_PASSWORD_SEGURA
POSTGRES_DB=baqueano_natales
POSTGRES_HOST=db
POSTGRES_PORT=5432
DATABASE_URL=postgresql://${POSTGRES_USER}:${POSTGRES_PASSWORD}@${POSTGRES_HOST}:${POSTGRES_PORT}/${POSTGRES_DB}

# --- Backend ---
BACKEND_HOST=0.0.0.0
BACKEND_PORT=8000
SECRET_KEY=CAMBIAR_openssl_rand_hex_32
ALGORITHM=HS256
ACCESS_TOKEN_EXPIRE_MINUTES=10080

# --- Cifrado de tokens sociales (Fernet) ---
# Generar con: python -c "from cryptography.fernet import Fernet; print(Fernet.generate_key().decode())"
TOKEN_ENCRYPTION_KEY=

# --- Firebase ---
FIREBASE_SERVICE_ACCOUNT_PATH=/app/secrets/firebase-service-account.json
FIREBASE_PROJECT_ID=baqueano-natales

# --- Auth: Google Sign-In ---
GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=

# --- Auth: OTP WhatsApp (Meta Cloud API) ---
WHATSAPP_API_URL=https://graph.facebook.com/v20.0
WHATSAPP_PHONE_NUMBER_ID=
WHATSAPP_ACCESS_TOKEN=
WHATSAPP_VERIFY_TOKEN=
WHATSAPP_TEMPLATE_NAME=auth_code_es

# --- Auth: OTP SMS (Twilio o proveedor local) ---
SMS_PROVIDER=twilio
TWILIO_ACCOUNT_SID=
TWILIO_AUTH_TOKEN=
TWILIO_FROM_NUMBER=

# --- OTP global ---
OTP_EXPIRATION_MINUTES=10
OTP_MAX_ATTEMPTS=5
OTP_RATE_LIMIT_PER_HOUR=3

# --- Admin ---
ADMIN_EMAILS=victorneyraars@gmail.com

# --- Nginx ---
DOMAIN_API=api.baqueanonatales.com
DOMAIN_ADMIN=admin.baqueanonatales.com

# --- Backups ---
BACKUP_GPG_PASSPHRASE=
BACKUP_RCLONE_REMOTE=b2:baqueano-natales-backups
BACKUP_LOCAL_DAYS=7
BACKUP_REMOTE_DAYS=90

# --- Vercel ---
VERCEL_DEPLOY_HOOK_URL=

# --- Storage de avatares ---
AVATAR_STORAGE_PATH=/app/media/avatars
PUBLIC_API_URL=https://api.baqueanonatales.com
MAX_AVATAR_SIZE_BYTES=5242880


# --- Facebook / Meta (OAuth + Graph API) ---
# App de Meta for Developers (https://developers.facebook.com/apps)
FACEBOOK_APP_ID=
FACEBOOK_APP_SECRET=
FACEBOOK_OAUTH_REDIRECT_URI=https://dev-api.baqueanonatales.com/api/v1/admin/social/facebook/oauth/callback
FACEBOOK_GRAPH_API_VERSION=v26.0
FACEBOOK_OAUTH_SCOPES=pages_show_list,pages_read_engagement,pages_manage_posts
